# managed by vaire - do not edit; use cluster.toml
# The cluster listens on its Unix socket only: clients arrive through the
# poolers, and vaire's own work runs on the node. pg_basebackup copies a live
# cluster into a temporary one over the replication line.
local   all             postgres                                peer
local   replication     postgres                                peer
local   all             vaire_monitor                             peer map=vaire
local   all             vaire_admin                               peer map=vaire
local   postgres        pgbouncer_auth                          peer map=vaire
local   all             all                                     scram-sha-256
