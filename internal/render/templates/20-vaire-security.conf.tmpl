# managed by vaire - do not edit; use cluster.toml
# Socket only: the port names the socket. ssl stays on for the replication
# listener of later phases.
listen_addresses = ''
port = {{ .Port }}
ssl = on
ssl_cert_file = '/etc/vaire/tls/server.crt'
ssl_key_file = '/etc/vaire/tls/server.key'
ssl_min_protocol_version = 'TLSv1.2'
password_encryption = 'scram-sha-256'
allow_alter_system = off
log_line_prefix = '%m [%p] %q%u@%d %h '
log_connections = 'receipt,authentication,authorization'
log_disconnections = on
log_lock_waits = on
log_temp_files = '10MB'
log_checkpoints = on
log_autovacuum_min_duration = '10s'
