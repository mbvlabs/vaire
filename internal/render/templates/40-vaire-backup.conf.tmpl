# managed by vaire - do not edit; use cluster.toml
# WAL archiving is on from creation, so turning backups on or off is a
# reload. Without a bucket every segment is discarded. archive_timeout
# bounds the recovery point on an idle cluster. vaire node archive-push
# refuses on a master a newer one fenced, then runs pgBackRest's. pgBackRest
# requires "pgbackrest" in archive_command, hence --pgbackrest.
archive_mode = on
{{ if .Stanza }}archive_command = '/usr/local/bin/vaire node archive-push --pgbackrest={{ .PgBackRest }} --stanza={{ .Stanza }} %p'
{{ else }}archive_command = '/bin/true'
{{ end }}archive_timeout = 60s
