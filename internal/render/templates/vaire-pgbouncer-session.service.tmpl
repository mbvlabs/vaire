# managed by vaire - do not edit; use cluster.toml
[Unit]
Description=vaire session pooler (PgBouncer in session mode on 5432)
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
User=postgres
Group=postgres
RuntimeDirectory=vaire-pgbouncer-session
RuntimeDirectoryMode=0755
ExecStart=/usr/sbin/pgbouncer /etc/pgbouncer/session.ini
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
LimitNOFILE=65536
Restart=on-failure
[Install]
WantedBy=multi-user.target
