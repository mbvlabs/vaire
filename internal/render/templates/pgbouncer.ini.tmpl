; managed by eru - do not edit; use cluster.toml
[databases]
{{- range .Databases }}
{{ .Name }} = host=/var/run/postgresql port={{ .Port }}{{ if .DBName }} dbname={{ .DBName }}{{ end }} auth_dbname={{ .Name }}__auth max_db_connections={{ .MaxConnections }}
{{ .Name }}__auth = host=/var/run/postgresql port={{ .Port }} dbname=postgres pool_size=2
{{- end }}

[pgbouncer]
listen_addr = *
listen_port = {{ .Port }}
unix_socket_dir = {{ .SocketDir }}
{{- if .PidFile }}
pidfile = {{ .PidFile }}
{{- end }}
auth_type = hba
auth_hba_file = {{ .HBAPath }}
auth_file = /etc/pgbouncer/userlist.txt
auth_user = pgbouncer_auth
{{- if .AdminAuthDB }}
auth_dbname = {{ .AdminAuthDB }}
{{- end }}
auth_query = SELECT usename, passwd FROM eru.{{ .AuthFunction }}($1)
pool_mode = {{ .Mode }}
{{- if eq .Mode "transaction" }}
max_prepared_statements = 200
{{- end }}
max_client_conn = {{ .ClientConnections }}
default_pool_size = {{ .DefaultPoolSize }}
min_pool_size = 0
{{- if eq .Mode "transaction" }}
reserve_pool_size = 5
server_reset_query =
{{- else }}
application_name_add_host = 1
{{- end }}
{{- if eq .Mode "transaction" }}
ignore_startup_parameters = extra_float_digits,search_path,options
{{- else }}
ignore_startup_parameters = extra_float_digits
track_extra_parameters = IntervalStyle,search_path,default_transaction_read_only,role
{{- end }}
client_tls_sslmode = {{ .ClientTLS }}
client_tls_cert_file = /etc/eru/tls/server.crt
client_tls_key_file = /etc/eru/tls/server.key
client_tls_protocols = tlsv1.2,tlsv1.3
server_tls_sslmode = disable
admin_users = eru_admin
stats_users = eru_monitor
log_connections = 1
log_disconnections = 1
